<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-plugin-request-location-accuracy"
    version="3.0.0">

    <name>Request Location Accuracy</name>
    <description>Cordova plugin for Android and iOS that asks the user to turn on location (and, on Android, the requested location accuracy) through the native system dialog.</description>
    <author>Dave Alden</author>
    <license>MIT</license>
    <keywords>ecosystem:cordova,cordova,android,ios,location,accuracy,high accuracy,gps,settings</keywords>
    <repo>https://github.com/gcferraria/cordova-plugin-request-location-accuracy.git</repo>
    <issue>https://github.com/gcferraria/cordova-plugin-request-location-accuracy/issues</issue>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
        <engine name="cordova-android" version=">=10.0.0" />
        <engine name="cordova-ios" version=">=6.0.0" />
    </engines>

    <js-module src="www/RequestLocationAccuracy.js" name="RequestLocationAccuracy">
        <clobbers target="cordova.plugins.locationAccuracy" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="RequestLocationAccuracy">
                <param name="android-package" value="cordova.plugin.RequestLocationAccuracy" />
            </feature>
        </config-file>

        <source-file src="src/android/RequestLocationAccuracy.java" target-dir="src/cordova/plugin" />

        <!-- play-services-location 21+ is required: the plugin uses LocationRequest.Builder and Priority. -->
        <preference name="PLAY_SERVICES_LOCATION_VERSION" default="21.3.0" />
        <framework src="com.google.android.gms:play-services-location:$PLAY_SERVICES_LOCATION_VERSION" />
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="RequestLocationAccuracy">
                <param name="ios-package" value="RequestLocationAccuracy" />
            </feature>
        </config-file>

        <header-file src="src/ios/RequestLocationAccuracy.h" />
        <source-file src="src/ios/RequestLocationAccuracy.m" />

        <framework src="CoreLocation.framework" />
    </platform>
</plugin>
