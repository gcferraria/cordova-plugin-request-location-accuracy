{
    "name": "cordova-plugin-request-location-accuracy",
    "version": "3.0.0",
    "description": "Cordova plugin for Android and iOS that asks the user to turn on location (and, on Android, the requested location accuracy) through the native system dialog.",
    "author": "Dave Alden",
    "contributors": [
        "Gonçalo Ferraria"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gcferraria/cordova-plugin-request-location-accuracy.git"
    },
    "bugs": {
        "url": "https://github.com/gcferraria/cordova-plugin-request-location-accuracy/issues"
    },
    "cordova": {
        "id": "cordova-plugin-request-location-accuracy",
        "platforms": [
            "android",
            "ios"
        ]
    },
    "engines": {
        "cordovaDependencies": {
            "3.0.0": {
                "cordova": ">=10.0.0",
                "cordova-android": ">=10.0.0",
                "cordova-ios": ">=6.0.0"
            }
        }
    },
    "keywords": [
        "ecosystem:cordova",
        "cordova",
        "cordova-android",
        "cordova-ios",
        "location",
        "accuracy",
        "high accuracy",
        "gps",
        "settings"
    ]
}
